events {}

http {
	server
	{
		listen 443 ssl;
		listen [::]:443 ssl;
		
		root /var/www/html;	
		index index.html index.htm index.php;		


		ssl_protocols TLSv1.3;
		ssl_certificate /etc/nginx/ssl/inception.crt;
        	ssl_certificate_key /etc/nginx/ssl/inception.key;
		
		server_name kacherch.42.fr;

		location / {
			try_files $uri $uri/ =404;
		}
	}
}
